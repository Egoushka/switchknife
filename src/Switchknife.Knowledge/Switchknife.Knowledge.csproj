<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Switchknife.Knowledge</PackageId>
    <MinVerTagPrefix>knowledge/v</MinVerTagPrefix>
    <Description>A knowledge kit over Switchknife.Facts. Ideas chain: free capture of a seed, a promotion gate (value hypothesis and cheapest test with a pass line) enforced by IdeaValidator, and a chain from idea to experiment to result to earned UAH. Never calls a model or the network. Native AOT compatible.</Description>
    <PackageTags>knowledge;facts;ideas;validation;agents;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switchknife.Facts\Switchknife.Facts.csproj" />
  </ItemGroup>

</Project>
