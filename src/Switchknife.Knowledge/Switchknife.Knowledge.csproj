<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Switchknife.Knowledge</PackageId>
    <MinVerTagPrefix>knowledge/v</MinVerTagPrefix>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>A knowledge kit over Switchknife.Facts. Retrieval: idf-weighted full text that survives a question written as a sentence, entity-level ranking and reciprocal-rank fusion across namespaces. Ideas chain: free capture of a seed, a promotion gate (value hypothesis and cheapest test with a pass line) enforced by IdeaValidator, and a chain from idea to experiment to result to earned UAH. Never calls a model or the network. Native AOT compatible.</Description>
    <PackageTags>knowledge;facts;retrieval;search;entity-ranking;rank-fusion;ideas;validation;agents;postgresql;npgsql;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Switchknife.Facts\Switchknife.Facts.csproj" />
  </ItemGroup>

</Project>
