<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Switchknife.Facts</PackageId>
    <MinVerTagPrefix>facts/v</MinVerTagPrefix>
    <Description>Bi-temporal facts in your own PostgreSQL that can explain themselves: immutable rows with a valid time and a transaction time, cardinality-typed predicates, retraction, purge of a source by replay, ExplainAsync for why a fact is believed, full-text and vector search fused by reciprocal rank, and a provider-neutral kit for extracting facts with a language model. Native AOT compatible.</Description>
    <PackageTags>facts;temporal;bitemporal;knowledge-graph;memory;agents;llm;extraction;vector-search;full-text-search;postgresql;npgsql;aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>

</Project>
