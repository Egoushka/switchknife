<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published with Native AOT in CI (scripts/aot-smoke.sh): every package must work, not only build, without the JIT. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Switchknife.Hosting\Switchknife.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Switchknife.Journal\Switchknife.Journal.csproj" />
    <ProjectReference Include="..\..\src\Switchknife.McpGuard\Switchknife.McpGuard.csproj" />
    <ProjectReference Include="..\..\src\Switchknife.Migrations\Switchknife.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations/*.sql" />
  </ItemGroup>

</Project>
